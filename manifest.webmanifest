{
  "id": "calctudo-app",
  "name": "CalcTudo",
  "short_name": "CalcTudo",
  "description": "CalcTudo: calculadora básica e científica, juros, investimentos, metas, financiamento imobiliário, porcentagem, unidades e datas.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#DCE0E5",
  "theme_color": "#DCE0E5",
  "categories": ["finance", "utilities", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Científica", "short_name": "Científica", "url": "./?tab=sci" },
    { "name": "Juros", "short_name": "Juros", "url": "./?tab=juros" },
    { "name": "Investir", "short_name": "Investir", "url": "./?tab=invest" },
    { "name": "Financiamento de imóvel", "short_name": "Imóvel", "url": "./?tab=imovel" }
  ]
}
